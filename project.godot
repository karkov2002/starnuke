; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Star Nuke"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

MCPRuntime="*uid://d3mawvfkf8rq6"
NukeClock="*res://nuke/nuke_clock.gd"
GameSettings="*res://scripts/game_settings.gd"

[display]

window/size/viewport_width=1920.0
window/size/viewport_height=1080.0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[internationalization]

locale/translations=["res://locale/strings.en.translation", "res://locale/strings.fr.translation", "res://locale/strings.es.translation", "res://locale/strings.de.translation", "res://locale/strings.it.translation", "res://locale/countries.en.translation", "res://locale/countries.fr.translation", "res://locale/countries.es.translation", "res://locale/countries.de.translation", "res://locale/countries.it.translation"]

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
