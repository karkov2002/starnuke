.godot/
# Cache du serveur MCP Godot (captures, instantanés d'annulation)
addons/godot_mcp/cache/
# Traductions compilées par l'import des CSV de langue (locale/*.csv), régénérées par l'éditeur
locale/*.translation
# Playlists personnelles (musiques déposées dans playlist/) : seules la playlist par défaut « starnuke » et le
# .gdignore sont versionnés
playlist/*
!playlist/.gdignore
!playlist/starnuke/
# Campagnes personnelles (dossiers déposés dans campaign/) : seules la campagne officielle « starnuke » et le
# .gdignore sont versionnés
campaign/*
!campaign/.gdignore
!campaign/starnuke/
